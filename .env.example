# ---------------------------------------------------------------------------
# Pluck configuration. Copy to .env and fill in. Only the first two are
# required for a local self-hosted stack; everything else has a sane default.
# ---------------------------------------------------------------------------

# Encrypts stored model-provider keys. Any random string of 32+ characters.
#   openssl rand -hex 32
PLUCK_ENCRYPTION_KEY=

# An API key that works immediately, with no sign-in. Self-host convenience.
#   openssl rand -hex 24
BOOTSTRAP_API_KEY=

# --- URLs -------------------------------------------------------------------
PUBLIC_API_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:3000

# --- Storage (docker compose sets these for you) ----------------------------
POSTGRES_PASSWORD=pluck
# DATABASE_URL=postgres://pluck:pluck@postgres:5432/pluck
# REDIS_URL=redis://redis:6379              # queues: needs maxmemory-policy noeviction
# CACHE_REDIS_URL=redis://redis-cache:6379  # cache + rate limits: allkeys-lru

# --- Model provider ---------------------------------------------------------
# Used when a caller does not bring their own key. Leave blank and AI
# endpoints will ask the caller for one instead.
# Providers: openrouter | openai | anthropic | google | groq | openai-compatible
PLUCK_LLM_PROVIDER=openrouter
PLUCK_LLM_API_KEY=
PLUCK_LLM_MODEL=google/gemini-3.8-flash
# PLUCK_LLM_BASE_URL=http://host.docker.internal:11434/v1   # e.g. Ollama

# --- Search -----------------------------------------------------------------
# Tried in this order; SearXNG runs in compose and needs no key.
SEARCH_PROVIDERS=brave,serper,searxng
BRAVE_API_KEY=
SERPER_API_KEY=

# --- Proxies (optional) -----------------------------------------------------
# Instance-wide egress; accounts can add their own from the dashboard instead.
# Comma-separated. {country} and {session} are substituted per request.
PROXY_DATACENTER_URLS=
PROXY_RESIDENTIAL_URLS=

# --- Browser fleet ----------------------------------------------------------
BROWSER_CONCURRENCY=4
CRAWL_CONCURRENCY=4
# WORKER_ROLES=render,crawl,monitor,webhook,maintenance

# --- Object storage (screenshots, logos) ------------------------------------
# Compose points these at its bundled SeaweedFS (STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY set its credentials). For Cloudflare R2:
#   S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#   STORAGE_PUBLIC_URL=https://cdn.example.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# --- Dashboard --------------------------------------------------------------
# GitHub OAuth app; callback: <PUBLIC_WEB_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BETTER_AUTH_SECRET=
# Lets the dashboard playground call the API as the signed-in user.
INTERNAL_API_SECRET=
# API key the public landing-page demo uses (optional).
DEMO_API_KEY=

# --- Safety and limits ------------------------------------------------------
# 0 disables rate limiting. Never enable private network access on a public host.
RATE_LIMIT_PER_MINUTE=0
ALLOW_PRIVATE_NETWORK=false
LOG_LEVEL=info

# --- Hosted service only ----------------------------------------------------
# Credits and payments. Self-hosted instances leave BILLING_ENABLED false.
BILLING_ENABLED=false
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
# One Polar product per credit pack:
POLAR_PRODUCT_STARTER=
POLAR_PRODUCT_BUILDER=
POLAR_PRODUCT_SCALE=
POLAR_PRODUCT_HYPER=

# --- Email (optional) -------------------------------------------------------
# Without a key the contact form still stores the request, but nobody is told.
RESEND_API_KEY=
EMAIL_FROM=Pluck <hello@example.com>
# Where enterprise enquiries are sent.
CONTACT_EMAIL=
# Warn an account by email once its balance falls below this (billing only).
LOW_BALANCE_CREDITS=200

# --- Error tracking and alerts (optional) -----------------------------------
# Any Sentry-compatible ingest: Sentry, GlitchTip or a self-hosted Bugsink.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Operational alerts: queue backlogs, crashes. Both targets work together.
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Operator panel at /admin: a username and password, then a TOTP code from an
# authenticator app (the first sign-in shows a QR code to enrol it). Create the
# hash with `node scripts/admin-password.mjs`. Needs PLUCK_ENCRYPTION_KEY too;
# leave either of these empty and /admin answers 404. Telegram above, if set,
# gets sign-in alerts. Lost the phone? Delete the admin_totp row in the
# database and the next sign-in enrols a new one.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# --- Deployment tooling (not read by the app) -------------------------------
# COOLIFY_API_URL=
# COOLIFY_API_TOKEN=
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
